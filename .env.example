# Copy to .env for local runs. In deployment these are stored in GCP Secret Manager,
# never committed. See docs/09-deployment.md.

# --- Agora Conversational AI Engine -----------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
AGORA_IDLE_TIMEOUT=60

# "mllm" = Gemini Live speech-to-speech (primary path, D7).
# "cascade" = asr -> our /agora/llm webhook -> tts (fallback path, D7).
AGENT_MODE=mllm

# --- Gemini --------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Charon
GEMINI_TEXT_MODEL=gemini-3-flash

# --- Deployment ------------------------------------------------------------
# Publicly reachable base URL of this service, no trailing slash. Used to build the
# per-channel cascade webhook URL Agora calls: {PUBLIC_BASE_URL}/agora/llm/{channel}/v1/chat/completions
PUBLIC_BASE_URL=
